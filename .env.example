# Moonbow Social Scheduler — local dev (Synalume)
# Copy: cp .env.example .env  then fill secrets. Never commit .env

# --- Phase 3: Neon (NEW project: moonbow-social-scheduler — NOT clinical Neon) ---
# Pooled connection string from Neon dashboard
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooler) connection string
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Phase 4: NextAuth (scheduler admin login via Google) ---
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google Cloud OAuth → Web client → redirect: http://localhost:3000/api/auth/callback/google
# Sign in with team@synalume.com (same Google account used for YouTube channel admin)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Phase 2: MuAPI (use moonbow-marketing-prod for real YouTube/TikTok connect) ---
MUAPIAPP_API_KEY=""

# OAuth base URL fallback inside scheduler (NOT Synalume approve webhook)
WEBHOOK_URL="http://localhost:3000"

# --- Stripe (optional for local dev — leave empty; seed credits via Neon SQL instead) ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
